{
    "name": "yireo/magento2-page-cache-csp-nonce-regenerator",
    "version": "0.0.3",
    "description": "Magento module to regenerate CSP nonces when built-in Page Cache is enabled",
    "type": "magento2-module",
    "require": {
        "ext-pcre": "*",
        "magento/framework": "^103.0",
        "magento/module-csp": "^100.0",
        "magento/module-page-cache": "^100.0",
        "magento/module-store": "^101.1",
        "php": ">=8.2 <8.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "yireo/magento2-integration-test-helper": "~0.0"
    },
    "license": "OSL-3.0",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Yireo\\PageCacheCspNonceRegenerator\\": ""
        }
    }
}